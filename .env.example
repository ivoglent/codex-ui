PROJECTS_ROOT=/absolute/path/to/projects
HOST_UID=1000
HOST_GID=1000
# Optional: override the default host mount, ${HOME}/.codex.
# HOST_CODEX_HOME=/home/your-user/.codex
PUBLIC_ORIGIN=http://localhost:3210
# Shared visual identity for this deployment. APP_ICON_URL must be a
# same-origin absolute path, such as /assets/brand.svg.
APP_TITLE=Codex Control
APP_SHORT_NAME=Codex
APP_ICON_URL=/favicon.svg
APP_THEME_COLOR=#111827
APP_BACKGROUND_COLOR=#090d16
# Generate a VAPID key pair for the deployment. The private key must remain a
# deployment secret; the public key is sent to browsers when they subscribe.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# In containers compose.yml persists this below the mounted Codex home.
WEB_PUSH_SUBSCRIPTIONS_PATH=
