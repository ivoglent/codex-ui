location /codex/ {
  # Codex UI has no built-in user authentication. Keep this behind an
  # authenticated reverse proxy; never expose the container port directly.
  auth_basic "Codex UI";
  auth_basic_user_file /etc/nginx/.htpasswd-codex-ui;
  proxy_pass http://127.0.0.1:3210/;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Origin https://codex.example.com;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 1h;
  client_max_body_size 12m;
}
