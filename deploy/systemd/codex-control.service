[Unit]
Description=Codex Control PWA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-control
WorkingDirectory=/opt/codex-control
EnvironmentFile=-/etc/codex-control/environment
ExecStart=/usr/bin/env corepack pnpm --filter @codex-control/server start
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
