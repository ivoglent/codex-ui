{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.svg", "src/manifest.webmanifest", { "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"],
            "serviceWorker": "ngsw-config.json",
            "outputPath": "dist"
          },
          "configurations": { "production": { "outputHashing": "all", "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true }, "budgets": [{ "type": "initial", "maximumWarning": "800kB", "maximumError": "1.5MB" }] }, "development": { "optimization": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "development": { "buildTarget": "web:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
